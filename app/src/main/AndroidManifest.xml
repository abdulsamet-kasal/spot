<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required by Media3 for background playback (Android 14+ needs FOREGROUND_SERVICE). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Keeps the CPU awake while playing (setWakeMode(C.WAKE_MODE_NETWORK)),
         so streaming does not stop when the screen turns off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- WAKE_MODE_NETWORK also holds a Wi-Fi lock, and WifiManager.createWifiLock() requires
         ACCESS_WIFI_STATE; without it the radio sleeps on screen-off and the stream stalls. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- ACCESS_WIFI_STATE would otherwise imply Wi-Fi hardware as a requirement. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <!-- Lets the settings screen ask the user to exempt Spoyt from battery optimization,
         so aggressive OEM power savers do not kill background playback. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Required to show the media notification and lock-screen controls (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Downloads use app-specific internal storage, so no storage permissions are needed. -->

    <application
        android:name=".di.SpoytApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Spoyt"
        android:usesCleartextTraffic="true">

        <!-- Single activity hosting all Compose screens via Navigation Compose. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press app shortcuts (search / liked / downloads). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- MediaSessionService keeps playback alive in the background and publishes the
             media notification / lock-screen controls. The intent-filter is the Media3
             contract that lets the system, Bluetooth devices and the lock screen talk to
             the session (this is what makes headset play/pause work). -->
        <service
            android:name=".player.MusicPlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Home screen widget: current track + play/pause/next/prev transport buttons. -->
        <receiver
            android:name=".player.SpoytWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/spoyt_widget_info" />
        </receiver>

    </application>

</manifest>
