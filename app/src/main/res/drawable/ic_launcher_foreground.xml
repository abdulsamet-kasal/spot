<?xml version="1.0" encoding="utf-8"?>
<!--
  Sametify mark: five rounded equalizer bars of different heights, painted with one
  mint-to-violet vertical gradient. Read as "music" at a glance, stays legible inside both
  the circular and the squircle adaptive-icon masks, and needs no bitmap assets.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer bars: dimmer for depth. -->
    <path android:pathData="M23.5,48.5 A4.5,4.5 0 0 1 32.5,48.5 L32.5,59.5 A4.5,4.5 0 0 1 23.5,59.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="24"
                android:endX="54" android:endY="84"
                android:startColor="#B335F0A0"
                android:centerColor="#B33BC9DB"
                android:endColor="#B37C5CFF" />
        </aapt:attr>
    </path>
    <path android:pathData="M79.5,48.5 A4.5,4.5 0 0 1 88.5,48.5 L88.5,59.5 A4.5,4.5 0 0 1 79.5,59.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="24"
                android:endX="54" android:endY="84"
                android:startColor="#B335F0A0"
                android:centerColor="#B33BC9DB"
                android:endColor="#B37C5CFF" />
        </aapt:attr>
    </path>

    <!-- Inner pair. -->
    <path android:pathData="M37.5,39.5 A4.5,4.5 0 0 1 46.5,39.5 L46.5,68.5 A4.5,4.5 0 0 1 37.5,68.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="24"
                android:endX="54" android:endY="84"
                android:startColor="#35F0A0"
                android:centerColor="#3BC9DB"
                android:endColor="#7C5CFF" />
        </aapt:attr>
    </path>
    <path android:pathData="M65.5,39.5 A4.5,4.5 0 0 1 74.5,39.5 L74.5,68.5 A4.5,4.5 0 0 1 65.5,68.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="24"
                android:endX="54" android:endY="84"
                android:startColor="#35F0A0"
                android:centerColor="#3BC9DB"
                android:endColor="#7C5CFF" />
        </aapt:attr>
    </path>

    <!-- Tallest bar carries the brand accent. -->
    <path android:pathData="M51.5,30.5 A4.5,4.5 0 0 1 60.5,30.5 L60.5,77.5 A4.5,4.5 0 0 1 51.5,77.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="24"
                android:endX="54" android:endY="84"
                android:startColor="#35F0A0"
                android:centerColor="#35F0A0"
                android:endColor="#3BC9DB" />
        </aapt:attr>
    </path>
</vector>
