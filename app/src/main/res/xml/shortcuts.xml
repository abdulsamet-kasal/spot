<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press app icon shortcuts: jump straight into a tab. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_search"
        android:shortcutLongLabel="@string/shortcut_search">
        <intent
            android:action="com.example.spoyt.action.OPEN_TAB"
            android:targetPackage="com.example.spoyt"
            android:targetClass="com.example.spoyt.MainActivity" />
        <extra android:name="tab" android:value="search" />
    </shortcut>

    <shortcut
        android:shortcutId="liked"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_liked"
        android:shortcutLongLabel="@string/shortcut_liked">
        <intent
            android:action="com.example.spoyt.action.OPEN_TAB"
            android:targetPackage="com.example.spoyt"
            android:targetClass="com.example.spoyt.MainActivity" />
        <extra android:name="tab" android:value="liked" />
    </shortcut>

    <shortcut
        android:shortcutId="downloads"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_downloads"
        android:shortcutLongLabel="@string/shortcut_downloads">
        <intent
            android:action="com.example.spoyt.action.OPEN_TAB"
            android:targetPackage="com.example.spoyt"
            android:targetClass="com.example.spoyt.MainActivity" />
        <extra android:name="tab" android:value="downloads" />
    </shortcut>
</shortcuts>
